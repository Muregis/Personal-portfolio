# Environment configuration for Victor Muregi Portfolio
#
# Copy to .env for local development, or set as environment variables in your
# host (Vercel project → Settings → Environment Variables). Prefixes:
#   NEXT_PUBLIC_*  → inlined into the browser bundle (safe, not secret)
#   others         → server-only (secrets)

# ── Analytics ───────────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID. When empty/unset the tracking snippet is
# not loaded at all. Example: G-XXXXXXXXXX
GA4_MEASUREMENT_ID=

# ── Error monitoring (Sentry) ───────────────────────────────────────────────
# Public DSN, inlined into the browser bundle (required for client errors).
# Create one at https://sentry.io/ → project → Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Optional label for the environment sent with events (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=production
# Optional: server-only DSN override (falls back to NEXT_PUBLIC_SENTRY_DSN).
SENTRY_DSN=

# Optional — source map upload during `next build` (CI only):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin used by metadata, sitemap.xml, robots.txt, llms.txt links.
# Must match the production domain exactly (no trailing slash).
# Defaults to the project's Vercel URL (src/lib/site.ts). Point this at your
# custom domain once attached, e.g. https://muregi.dev
NEXT_PUBLIC_SITE_URL=https://personal-portfolio-muregis-projects.vercel.app
